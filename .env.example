# Copy to .env on the server for deployment. NEVER commit the real .env.
# All values are read server-side only and are never sent to the browser.

# ---------------------------------------------------------------------------
# Temporary shared login password (placeholder auth until the real Core
# Engine identity service is wired in). Any username/email is accepted; this
# is the password. Generate a strong value:  openssl rand -base64 24
# If unset in production, the login endpoint fails closed (503).
# ---------------------------------------------------------------------------
CE_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Application database (Postgres). PG_PASSWORD is used by compose to build the
# db container and the DATABASE_URL both `coreengine-web` and `migrate` see.
# Generate:  openssl rand -base64 24
# ---------------------------------------------------------------------------
PG_PASSWORD=

# Set automatically by compose for the containers; only needed here when
# running the app or the importer outside compose (e.g. local dev).
# DATABASE_URL=postgres://core_engine:<PG_PASSWORD>@db:5432/core_engine

# ---------------------------------------------------------------------------
# Future: base URL of the Core Engine agent backend. Leave blank for now.
# ---------------------------------------------------------------------------
# CORE_ENGINE_API_URL=
# CORE_ENGINE_API_TOKEN=
